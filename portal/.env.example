# Copy this file to .env.local and fill in real values. See README.md for
# the full setup walkthrough -- this file only documents what each variable
# is and exactly where to get it.
#
# The app builds and typechecks fine with this file left as-is (no code
# path requires a live network call at build time) -- these are only
# needed to actually run `npm run dev` / `npm start` against a real backend.

# -----------------------------------------------------------------------------
# Supabase (Auth + Postgres + RLS + the claim/heartbeat/tenancy RPCs)
# -----------------------------------------------------------------------------
# Supabase Dashboard -> Project Settings -> Data API (or "API" on older
# dashboards). Bare project URL, e.g. https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Dashboard -> Project Settings -> API Keys -> "publishable" key
# (the current replacement for the legacy "anon" key naming; functionally
# equivalent -- safe to expose to the browser, has zero table grants on its
# own, see supabase/README.md's Auth model section).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# Supabase Dashboard -> Project Settings -> API Keys -> "service_role"
# secret key. SERVER-ONLY -- never prefix this with NEXT_PUBLIC_, never send
# it to the browser. Used through src/lib/supabase/admin.ts for invites,
# authenticated device-sync operations, and storage verification updates.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx

# -----------------------------------------------------------------------------
# This app
# -----------------------------------------------------------------------------
# Used to build absolute redirect URLs for email confirmation / password
# reset links (emailRedirectTo / resetPasswordForEmail's redirectTo).
# Local dev: http://localhost:3000. Production: your real deployed URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional legacy operator-managed connections. New accounts connect in the GUI.
# See ../CAPTURE_SYNC.md. Never add a NEXT_PUBLIC_ prefix.
HARDHAT_STORAGE_CREDENTIALS='{}'
# HTTPS is required by default. Enable HTTP only in isolated local MinIO tests.
HARDHAT_ALLOW_INSECURE_STORAGE=false

# Encrypts MinIO/S3 static secret keys an org_admin pastes into the
# "Connect storage" GUI (src/lib/storage/crypto.ts) before they're stored in
# storage_connection_secrets.ciphertext. Format: "id:base64key" pairs,
# comma-separated if you have more than one (rotate by adding a new id:key
# pair at the FRONT of the list -- new encryption always uses the first
# entry, older entries stay around so previously-encrypted rows stay
# decryptable). Each key must decode to exactly 32 bytes (AES-256). This key
# is the only thing standing between a Postgres dump/replica leak and every
# customer's storage credentials -- keep it out of source control and out of
# Postgres entirely (a secrets manager, not an env var checked into
# anything, in production). Generate one locally with:
#   node -e "console.log('v1:' + require('crypto').randomBytes(32).toString('base64'))"
HARDHAT_STORAGE_ENCRYPTION_KEYS=v1:REPLACE_WITH_BASE64_OF_32_RANDOM_BYTES

# Optional but recommended: this deployment's own AWS calling identity ARN
# (the role/user the AWS SDK's default credential chain resolves to on
# whatever host runs this server -- an ECS/EC2 workload role in production).
# Shown to customers in the "Connect storage" wizard's generated IAM trust
# policy so they know who to trust in their own account. Purely informational
# -- the actual AssumeRole call always uses whatever identity is really
# running, this just saves an admin from having to go look it up separately.
HARDHAT_AWS_TRUST_PRINCIPAL_ARN=arn:aws:iam::123456789012:role/hardhat-portal-workload

# Optional exact origins for deliberately private MinIO deployments. The GUI
# cannot modify this allowlist. Public HTTPS MinIO needs no entry here.
HARDHAT_STORAGE_PRIVATE_ENDPOINTS='[]'
