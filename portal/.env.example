# Copy this file to .env.local and fill in real values. See README.md for
# the full setup walkthrough -- this file only documents what each variable
# is and exactly where to get it.
#
# The app builds and typechecks fine with this file left as-is (no code
# path requires a live network call at build time) -- these are only
# needed to actually run `npm run dev` / `npm start` against a real backend.

# -----------------------------------------------------------------------------
# Supabase (Auth + Postgres + RLS + the claim/heartbeat/tenancy RPCs)
# -----------------------------------------------------------------------------
# Supabase Dashboard -> Project Settings -> Data API (or "API" on older
# dashboards). Bare project URL, e.g. https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Dashboard -> Project Settings -> API Keys -> "publishable" key
# (the current replacement for the legacy "anon" key naming; functionally
# equivalent -- safe to expose to the browser, has zero table grants on its
# own, see supabase/README.md's Auth model section).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# Supabase Dashboard -> Project Settings -> API Keys -> "service_role"
# secret key. SERVER-ONLY -- never prefix this with NEXT_PUBLIC_, never send
# it to the browser. Used exclusively by src/lib/supabase/admin.ts, for
# supabase.auth.admin.inviteUserByEmail() (called from the invite Server
# Action) -- see supabase/README.md's "Invites" section for why that
# specific call requires this key and can't be done in SQL.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx

# -----------------------------------------------------------------------------
# This app
# -----------------------------------------------------------------------------
# Used to build absolute redirect URLs for email confirmation / password
# reset links (emailRedirectTo / resetPasswordForEmail's redirectTo).
# Local dev: http://localhost:3000. Production: your real deployed URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
