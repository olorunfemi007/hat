[Unit]
Description=Import a first-boot device identity from the boot partition, if present
Documentation=file:///opt/hardhat/device-agent/README.md
After=local-fs.target
Before=hardhat-heartbeat.service hardhat-sync.service

[Service]
Type=oneshot
ExecStart=/opt/hardhat/device-agent/import-device-json.sh

[Install]
WantedBy=multi-user.target
